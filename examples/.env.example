# Non-sensitive configuration — copy to .env

SHARE_HOST=localhost
SHARE_BIND_HOST=127.0.0.1
SHARE_PORT=8000
SHARE_DEBUG=true
SHARE_LOG_LEVEL=info

# Leave SHARE_DB_HOST empty to use the Unix socket (peer auth on this Mac).
SHARE_DB_HOST=
SHARE_DB_PORT=5432
SHARE_DB_NAME=share_dev
SHARE_DB_USER=ixanadu

SHARE_REDIS_URL=redis://127.0.0.1:6379/0

SHARE_FILE_ROOT=var/share/files
SHARE_TMP_ROOT=var/share/tmp

# WebOne nginx is 64M. Do not advertise more.
SHARE_MAX_FILE_BYTES=52428800
SHARE_MAX_ARTIFACT_BYTES=67108864
