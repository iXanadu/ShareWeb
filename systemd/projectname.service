[Unit]
Description=projectname FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=projectname
Group=projectname
WorkingDirectory=/opt/srv/projectname
Environment=PATH=/home/projectname/.pyenv/versions/projectname-3.13/bin:/usr/bin:/bin

ExecStart=/home/projectname/.pyenv/versions/projectname-3.13/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=projectname

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/srv/projectname/logs /opt/srv/projectname
PrivateTmp=true

[Install]
WantedBy=multi-user.target
